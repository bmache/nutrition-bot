# ---------------------------------------------------------
# Pick ONE provider. Everything else is optional.
# ---------------------------------------------------------
# gemini | ollama | openrouter | watsonx
LLM_PROVIDER=gemini

# --- gemini (free tier, has vision) ----------------------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- ollama (fully local, free forever) ------------------
# ollama pull llava && ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- openrouter ------------------------------------------
OPENROUTER_API_KEY=

# --- ibm watsonx -----------------------------------------
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- optional model overrides ----------------------------
# CHAT_MODEL=gemini/gemini-3.6-flash
# VISION_MODEL=gemini/gemini-3.6-flash

PORT=7860
